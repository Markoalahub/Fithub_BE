FITHUB_BE_IMAGE=meongja/fithub-be:latest
FITHUB_AI_IMAGE=meongja/fithub-ai:latest
FITHUB_BE_PORT=8080

MYSQL_DATABASE=fithub
MYSQL_USER=fithub
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me

OPENAI_API_KEY=change-me
FASTAPI_DATABASE_URL=sqlite+aiosqlite:////app/data/fitai_v2.db
LANGCHAIN_TRACING_ENABLED=false

JWT_SECRET=change-me-base64-secret
JWT_EXPIRATION=3600
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

GITHUB_CLIENT_ID=change-me
GITHUB_CLIENT_SECRET=change-me
GITHUB_REDIRECT_URI=http://your-ec2-host:8080/auth/github/callback
GITHUB_OAUTH_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}

KAKAO_CLIENT_ID=change-me
KAKAO_CLIENT_SECRET=change-me
KAKAO_REDIRECT_URI=http://your-ec2-host:8080/auth/kakao/callback
KAKAO_OAUTH_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}

APP_FRONTEND_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
SWAGGER_UI_ENABLED=true
SPRING_JPA_HIBERNATE_DDL_AUTO=update
JAVA_OPTS=-Xms256m -Xmx768m
